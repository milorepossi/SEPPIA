__pycache__/
*.py[cod]

# Embedding cache: 9.3 GB for the full run, regenerate with
# scripts/extract_embeddings.py. Lives on /scratch in practice and is passed
# with --embeddings-dir; this covers a local copy.
embeddings/
*.npy

# Per-arm checkpoints: ~1 MiB each for the 860-feature arms but ~54 MiB for a
# flatten arm (a 55040x256 first layer), so a full ladder is ~300 MiB. The
# original A0 checkpoints directly in RESULTS/ stay tracked; everything under
# a per-arm subdirectory is regenerable from slurm/ladder.sbatch.
RESULTS/*/*.pt

# Derived splits; metadata_*.json is kept so a split can be reproduced
DATA/split/*.xlsx
DATA/split/*.png

.ipynb_checkpoints/
.venv/
.DS_Store

# Slurm job logs
slurm/logs/

# Sweep runs: 33 directories of checkpoints and per-run metrics, regenerate
# with slurm/sweep_width.sbatch
RESULTS/sweep/

# Boltz-2 arm
DATA/rasmussen_clean.csv
boltz_cache/
boltz_*.npy
